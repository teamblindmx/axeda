{
  "name": "axeda",
  "private": true,
  "version": "0.0.0",
  "description": "Axeda: hierarchical role-based access control (global → company → business) on top of Better Auth.",
  "keywords": [
    "access-control",
    "authorization",
    "rbac",
    "roles",
    "permissions",
    "multi-tenant",
    "better-auth"
  ],
  "license": "Apache-2.0",
  "author": "TeamBlind",
  "contributors": [
    "DannieDev"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamblindmx/axeda.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "deps:check": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deps:check && npm run test",
    "changeset": "changeset",
    "demo": "tsx --tsconfig tsconfig.json examples/demo.ts",
    "bench": "tsx --tsconfig tsconfig.json bench/run.ts",
    "build": "node scripts/build.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sbom": "node scripts/sbom.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
