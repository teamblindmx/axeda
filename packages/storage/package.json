{
  "name": "@teamblind/axeda-storage",
  "version": "0.1.0-alpha.4",
  "description": "Object storage for Axeda images: Cloudflare R2, S3, MinIO and other S3-compatible stores, with signed uploads and no AWS SDK.",
  "license": "Apache-2.0",
  "author": "TeamBlind",
  "homepage": "https://github.com/teamblindmx/axeda#readme",
  "bugs": {
    "url": "https://github.com/teamblindmx/axeda/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamblindmx/axeda.git",
    "directory": "packages/storage"
  },
  "keywords": [
    "authorization",
    "better-auth",
    "s3",
    "cloudflare-r2",
    "presigned-url"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@teamblind/axeda-core": "^0.1.0-alpha.4"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
